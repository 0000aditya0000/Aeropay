# Server
NODE_ENV=development
PORT=3010
ALLOWED_ORIGINS=*
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AeroPay / AroPay Gateway
AEROPAY_BASE_URL=https://api.aropay-api.com
AEROPAY_MERCHANT_ID=6
AEROPAY_SECRET=YOUR_SECRET_HERE
AEROPAY_TIMEOUT_MS=30000
AEROPAY_RETRY_COUNT=3

# Callbacks (must be publicly reachable)
NOTIFY_URL=https://aeropay.yourdomain.com/api/payment/webhook
PAYOUT_NOTIFY_URL=https://aeropay.yourdomain.com/api/payout/webhook
RETURN_URL=https://your-app.com/

# MySQL (shared platform DB — same as SkillPay/EinPay)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skillpay
DB_LOGGING=false
DB_SYNC_LOG_TABLES=true

# Platform (Rollix777)
PLATFORM_BASE_URL=https://api.rollix777.com
WALLET_BONUS_MULTIPLIER=1.10

# Logging
LOG_LEVEL=info

# Shared with game-backend + all gateways (admin payout create auth)
# Generate: node -e "console.log(require('crypto').createHash('sha256').update(require('crypto').randomBytes(32)).digest('hex'))"
PAYOUT_SECRET_KEY=
